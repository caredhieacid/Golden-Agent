# AI Recommendation Service Environment

# LLM Provider Configuration
# OpenAI (also works with compatible endpoints like DeepSeek, Qwen)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_key_here

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Default model selection
# Options: gpt-4o, gpt-4o-mini, claude-sonnet-4-20250514, deepseek-chat, qwen-plus
DEFAULT_MODEL=gpt-4o

# Service configuration
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0

# Data path (relative to golden-agent server data)
DATA_PATH=../server/data

# Analysis schedule (cron format)
# Default: every hour at minute 0
ANALYSIS_CRON=0 * * * *

# Recommendation output
OUTPUT_DIR=./output
MAX_RECOMMENDATIONS_PER_RUN=5

# Risk thresholds
HIGH_RISK_THRESHOLD=0.3
MEDIUM_RISK_THRESHOLD=0.6

# Disclaimer text shown with all recommendations
DISCLAIMER=仅供参考，不构成投资建议。投资有风险，入市需谨慎。
