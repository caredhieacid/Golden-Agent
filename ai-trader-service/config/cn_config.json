    "hot_stocks": "/api/stocks/hot",
    "gold": "/api/gold"
  },
  "schedule": {
    "cron": "0 * * * *",
    "description": "Every hour at minute 0"
  },
  "notes": [
    "A股市场波动较大，建议严格设置止损",
    "关注板块轮动节奏",
    "注意政策面变化",
