{
  "market": "cn",
  "name": "Chinese A-Share Market",
  "description": "Analysis configuration for Chinese A-share market recommendations",
  "indices_focus": [
    "000001", "399001", "399006"
  ],
  "sectors_focus": [
    "科技", "医药", "消费", "新能源", "金融", "地产", "军工"
