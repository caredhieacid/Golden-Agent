generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./golden-agent.db"
}
model GoldSnapshot {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  priceUsd     Float?
  priceCny     Float?
  exchangeRate Float?
  spreadPct    Float?

  @@index([timestamp])
  @@map("gold_snapshot")
}
model GoldDaily {
  id       Int      @id @default(autoincrement())
  date     DateTime @unique
  open     Float?
  high     Float?
  low      Float?
  close    Float
  volume   Float?

  @@index([date])
  @@map("gold_daily")
}
model StockIndex {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  market       String   @default("cn")
  price        Float?
  changePct    Float?
  changeAmount Float?
  volume       Float?
  amount       Float?
  updatedAt    DateTime @default(now())

  @@index([market])
  @@map("stock_index")
}
model Sector {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  changePct       Float?
  leaderStock     String?
  leaderChangePct Float?
  marketCap       Float?
  amount          Float?
  updatedAt       DateTime @default(now())

  @@map("sector")
}
model HotStock {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  price        Float?
  changePct    Float?
  changeAmount Float?
  volume       Float?
  amount       Float?
  high         Float?
  low          Float?
  open         Float?
  turnoverRate Float?
  peRatio      Float?
  updatedAt    DateTime @default(now())

  @@map("hot_stock")
}
model Politician {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  fullName  String   @unique
  chamber   String
  state     String
  party     String?
  district  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  trades    CongressTrade[]

  @@index([chamber])
  @@map("politician")
}
model CongressTrade {
  id              Int      @id @default(autoincrement())
  politicianId    Int?
  politician      Politician? @relation(fields: [politicianId], references: [id])

  ticker          String
  companyName     String?
  transactionType String
  amountMin       Float?
  amountMax       Float?
  transactionDate DateTime?
  disclosureDate  DateTime?
  sourceChamber   String   @default("house")
  docId           String?
  sourceUrl       String?
  politicianName  String?
  politicianParty String?
  politicianState String?

  createdAt       DateTime @default(now())

  @@index([ticker])
  @@index([transactionType])
  @@index([disclosureDate])
  @@index([politicianId])
  @@map("congress_trade")
}
model InsiderTrade {
  id              Int      @id @default(autoincrement())
  ticker          String
  companyName     String?
  insiderName     String
  insiderTitle    String?
  transactionType String
  shares          Float?
  pricePerShare   Float?
  totalValue      Float?
  sharesOwned     Float?
  filingDate      DateTime?
  transactionDate DateTime?
  secFormUrl      String?
  createdAt       DateTime @default(now())

  @@index([ticker])
  @@index([filingDate])
  @@index([insiderName])
  @@map("insider_trade")
}
model NewsEvent {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  summary   String?
  ticker    String?
  relatedEntity String?
  url       String?
  timestamp DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([ticker])
  @@map("news_event")
}
enum Role {
  USER
  VIP
  ADMIN
}
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}
enum PayStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  nickname      String?
  avatar        String?
  role          Role      @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique
  verifyExpires DateTime?
  resetToken    String?   @unique
  resetExpires  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  payments      Payment[]
  analytics     Analytics[]

  @@map("users")
}
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}
model Payment {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  amount        Float
  currency      String      @default("CNY")
  status        PayStatus   @default(PENDING)
  method        String?
  transactionId String?     @unique
  metadata      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("payments")
}
model Analytics {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  path      String
  method    String
  ip        String?
  userAgent String?
  referer   String?
  timestamp DateTime @default(now())

  @@index([path, timestamp])
  @@index([userId, timestamp])
  @@map("analytics")
}

